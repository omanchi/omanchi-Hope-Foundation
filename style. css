*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Inter',sans-serif;
scroll-behavior:smooth;
}

body{
background:#f4f6fb;
color:#111;
transition:0.3s;
}

body.dark{
background:#0f1115;
color:#eaeaea;
}

/* NAV */
nav{
position:fixed;
top:0;
width:100%;
display:flex;
justify-content:space-between;
align-items:center;
padding:14px 20px;
background:rgba(255,255,255,0.85);
backdrop-filter:blur(12px);
z-index:1000;
box-shadow:0 4px 20px rgba(0,0,0,0.08);
}

body.dark nav{
background:rgba(20,20,25,0.9);
}

.logo img{
height:55px;
}

.nav-links{
display:flex;
gap:10px;
align-items:center;
flex-wrap:wrap;
}

.nav-links a, button{
padding:8px 12px;
border:none;
border-radius:8px;
cursor:pointer;
background:transparent;
font-weight:600;
text-decoration:none;
color:inherit;
transition:0.2s;
}

.nav-links a:hover, button:hover{
transform:translateY(-2px);
}

.btn{
background:#ff6b35;
color:white;
}

/* HERO */
.hero{
height:100vh;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
background:url('hero.jpg') center/cover no-repeat;
position:relative;
color:white;
}

.hero::before{
content:'';
position:absolute;
inset:0;
background:rgba(0,0,0,0.55);
}

.hero-content{
position:relative;
max-width:800px;
}

.hero h1{
font-size:54px;
}

/* SECTIONS */
section{
padding:90px 20px;
max-width:1100px;
margin:auto;
}

.card{
background:white;
padding:25px;
border-radius:18px;
box-shadow:0 12px 30px rgba(0,0,0,0.08);
transition:0.3s;
}

body.dark .card{
background:#1a1d25;
}

img{
width:100%;
border-radius:12px;
margin-top:10px;
}

/* COUNTER */
.counter{
font-size:50px;
color:#ff6b35;
font-weight:bold;
}

.center{
text-align:center;
}

/* ANIMATION */
.fade{
animation:fadeUp 1s ease;
}

@keyframes fadeUp{
from{opacity:0;transform:translateY(20px);}
to{opacity:1;transform:translateY(0);}
}

/* SCROLL REVEAL */
.reveal{
opacity:0;
transform:translateY(30px);
transition:0.8s ease;
}

.reveal.active{
opacity:1;
transform:translateY(0);
}
