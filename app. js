function openAuth(){
  document.getElementById('auth').style.display='flex';
}

function closeAuth(){
  document.getElementById('auth').style.display='none';
}

function toggleDark(){
  document.body.classList.toggle('dark');
}

function shareSite(){
  if(navigator.share){
    navigator.share({
      title:'Omanchi Hope Foundation',
      url:location.href
    });
  }else{
    alert(location.href);
  }
}

// COUNTER
let c=0;
setInterval(()=>{
  if(c<120){
    c++;
    document.getElementById('counter').innerText=c;
  }
},30);
